/* ==========================================
   CAR'ESS
   Luxury Gourmet Collection
========================================== */

:root{

    --background:#181311;
    --surface:#221A18;
    --surface-light:#2D2421;

    --gold:#C9A34B;
    --gold-light:#E6CF8C;

    --cream:#F7F3EC;
    --white:#FFFFFF;

    --text:#F6F2EB;
    --text-soft:#CFC6BA;

    --shadow:0 15px 50px rgba(0,0,0,.35);

    --radius:18px;

    --transition:.35s ease;

}

/* ============================ */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    background:var(--background);

    color:var(--text);

    font-family:'Inter',sans-serif;

    overflow-x:hidden;

}

img{

    max-width:100%;

    display:block;

}

a{

    text-decoration:none;

    color:inherit;

}

ul{

    list-style:none;

}

.container{

    width:min(1280px,92%);

    margin:auto;

}

/* ============================ */
/* Typography */
/* ============================ */

h1,h2,h3,h4{

    font-family:"Cormorant Garamond",serif;

    font-weight:600;

    letter-spacing:.5px;

}

h1{

    font-size:5rem;

    line-height:1.05;

}

h2{

    font-size:3rem;

}

h3{

    font-size:2rem;

}

p{

    color:var(--text-soft);

    line-height:1.8;

}

/* ============================ */
/* Button */
/* ============================ */

.btn-primary{

display:inline-flex;

align-items:center;

justify-content:center;

padding:18px 42px;

margin-top:40px;

border:1px solid var(--gold);

border-radius:999px;

background:transparent;

color:var(--gold-light);

font-weight:600;

letter-spacing:2px;

text-transform:uppercase;

transition:var(--transition);

}

.btn-primary:hover{

background:var(--gold);

color:#181311;

transform:translateY(-4px);

box-shadow:0 12px 35px rgba(201,163,75,.35);

}

/* ============================ */
/* Header */
/* ============================ */

header{

position:fixed;

top:0;

left:0;

width:100%;

z-index:999;

padding:22px 0;

background:rgba(24,19,17,.72);

backdrop-filter:blur(16px);

transition:.4s;

}

header .container{

display:flex;

align-items:center;

justify-content:space-between;

}

.logo img{

height:62px;

}

nav ul{

display:flex;

gap:38px;

align-items:center;

}

nav a{

color:var(--cream);

font-weight:500;

position:relative;

}

nav a::after{

content:"";

position:absolute;

left:0;

bottom:-6px;

width:0;

height:1px;

background:var(--gold);

transition:.35s;

}

nav a:hover::after{

width:100%;

}

/* ============================ */
/* Dropdown */
/* ============================ */

.dropdown{

position:relative;

}

.submenu{

position:absolute;

top:100%;

left:0;

background:#241C19;

padding:15px 0;

border-radius:14px;

display:none;

min-width:220px;

box-shadow:var(--shadow);

}

.submenu li{

padding:12px 24px;

}

.dropdown:hover .submenu{

display:block;

}

/* ============================ */
/* Shopping Bag */
/* ============================ */

#shoppingBag{

display:flex;

align-items:center;

gap:14px;

cursor:pointer;

}

.bag-icon{

position:relative;

font-size:34px;

}

#bagCounter{

position:absolute;

right:-8px;

top:-8px;

background:var(--gold);

color:#181311;

width:22px;

height:22px;

border-radius:50%;

display:flex;

align-items:center;

justify-content:center;

font-size:12px;

font-weight:bold;

}
/* ==========================================
   HERO
========================================== */

.hero{

    min-height:100vh;

    display:flex;

    align-items:center;

    position:relative;

    overflow:hidden;

    background:
        radial-gradient(circle at top right,
        rgba(201,163,75,.12),
        transparent 35%),
        radial-gradient(circle at bottom left,
        rgba(201,163,75,.08),
        transparent 45%),
        #181311;

}

.hero-overlay{

    position:absolute;
    inset:0;

    background:
        linear-gradient(
        rgba(0,0,0,.25),
        rgba(24,19,17,.85));

}

.hero-content{

    position:relative;

    z-index:2;

    display:grid;

    grid-template-columns:1fr 1fr;

    align-items:center;

    gap:80px;

    padding-top:120px;

}

.hero-text{

    max-width:650px;

}

.eyebrow{

    color:var(--gold);

    letter-spacing:4px;

    text-transform:uppercase;

    font-size:.85rem;

}

.hero h1{

    margin:25px 0;

}

.hero p{

    font-size:1.15rem;

    max-width:560px;

}


/* ==========================================
   HERO PRODUCTS
========================================== */

.hero-products{

    position:relative;

    height:700px;

}

.hero-products img{

    position:absolute;

    transition:.6s;

    cursor:pointer;

    filter:drop-shadow(0 25px 35px rgba(0,0,0,.45));

}

.hero-products img:hover{

    transform:scale(1.08);

}

.product1{

    width:230px;

    left:20px;

    top:120px;

}

.product2{

    width:260px;

    right:40px;

    top:60px;

}

.product3{

    width:170px;

    left:150px;

    bottom:80px;

}

.product4{

    width:220px;

    right:100px;

    bottom:20px;

}


/* ==========================================
   FLOATING ANIMATION
========================================== */

.floating{

    animation:float 7s ease-in-out infinite;

}

@keyframes float{

    0%{

        transform:translateY(0);

    }

    50%{

        transform:translateY(-18px);

    }

    100%{

        transform:translateY(0);

    }

}


/* ==========================================
   GOLDEN JOURNEY
========================================== */

.golden-journey{

    position:fixed;

    right:80px;

    top:0;

    width:2px;

    height:100%;

    background:linear-gradient(

        transparent,

        var(--gold),

        transparent

    );

    opacity:.18;

    z-index:1;

}


/* ==========================================
   SECTION TITLE
========================================== */

section{

    padding:130px 0;

}

.section-title{

    text-align:center;

    max-width:760px;

    margin:0 auto 70px;

}

.section-title span{

    color:var(--gold);

    text-transform:uppercase;

    letter-spacing:4px;

    font-size:.8rem;

}

.section-title h2{

    margin:18px 0;

}


/* ==========================================
   COLLECTIONS
========================================== */

.collections-grid{

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:35px;

}

.collection-card{

    background:var(--surface);

    border-radius:24px;

    overflow:hidden;

    transition:.45s;

    box-shadow:var(--shadow);

}

.collection-card:hover{

    transform:translateY(-12px);

}

.collection-image{

    height:320px;

    overflow:hidden;

}

.collection-image img{

    width:100%;

    height:100%;

    object-fit:contain;

    background:#2A211E;

    transition:.6s;

}

.collection-card:hover img{

    transform:scale(1.08);

}

.collection-content{

    padding:40px;

}

.collection-number{

    color:var(--gold);

    font-size:.8rem;

    letter-spacing:4px;

}

.collection-content h3{

    margin:15px 0;

}

.collection-content ul{

    margin:30px 0;

}

.collection-content li{

    margin-bottom:12px;

    color:var(--cream);

}

.collection-link{

    color:var(--gold);

    font-weight:600;

}

.collection-link:hover{

    color:var(--gold-light);

}
/* ==========================================
   MOST LOVED
========================================== */

.products-grid{

    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:30px;

}

.product-card{

    position:relative;

    background:var(--surface);

    border-radius:22px;

    padding:30px;

    text-align:center;

    cursor:grab;

    transition:.35s;

    box-shadow:var(--shadow);

    border:1px solid transparent;

}

.product-card:hover{

    transform:translateY(-10px);

    border-color:rgba(201,163,75,.35);

}

.product-card:active{

    cursor:grabbing;

    transform:scale(.98);

}

.product-card img{

    height:220px;

    object-fit:contain;

    margin:20px auto;

    transition:.35s;

}

.product-card:hover img{

    transform:scale(1.08);

}

.product-card h3{

    margin:20px 0 10px;

}

.price{

    margin-top:20px;

    color:var(--gold);

    font-size:1.35rem;

    font-weight:700;

}

.drag-label{

    margin-top:20px;

    padding:12px;

    border-radius:999px;

    border:1px solid rgba(201,163,75,.35);

    color:var(--gold-light);

    font-size:.9rem;

}

.badge{

    position:absolute;

    top:18px;

    left:18px;

    background:linear-gradient(90deg,#C9A34B,#E9D18A);

    color:#181311;

    font-size:.72rem;

    padding:7px 14px;

    border-radius:999px;

    font-weight:700;

    text-transform:uppercase;

}

/* ==========================================
   PERFECT PAIRINGS
========================================== */

.pairing-grid{

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:30px;

}

