/* ==========================================
   CAR'ESS
========================================== */

const bag=document.getElementById("shoppingBag");
const drawer=document.getElementById("shoppingDrawer");
const close=document.getElementById("closeDrawer");
const counter=document.getElementById("bagCounter");
const toast=document.getElementById("toast");

let cart=[];

/* ============================= */

bag.addEventListener("click",()=>{

drawer.classList.add("open");

});

close.addEventListener("click",()=>{

drawer.classList.remove("open");

});

/* ============================= */
/* DRAG PRODUCTS */
/* ============================= */

const cards=document.querySelectorAll(".product-card");

cards.forEach(card=>{

card.addEventListener("dragstart",dragStart);

});

bag.addEventListener("dragover",e=>{

e.preventDefault();

bag.classList.add("bag-hover");

});

bag.addEventListener("dragleave",()=>{

bag.classList.remove("bag-hover");

});

bag.addEventListener("drop",dropProduct);

function dragStart(e){

e.dataTransfer.setData(

"text/plain",

JSON.stringify({

name:this.dataset.name,

price:this.dataset.price

})

);

}

function dropProduct(e){

e.preventDefault();

bag.classList.remove("bag-hover");

const product=JSON.parse(

e.dataTransfer.getData("text/plain")

);

cart.push(product);

updateCart();

showToast();

bag.animate([

{

transform:"scale(1)"

},

{

transform:"scale(1.15)"

},

{

transform:"scale(1)"

}

],{

duration:350

});

}

/* ============================= */

function updateCart(){

counter.textContent=cart.length;

const container=document.getElementById("cartItems");

container.innerHTML="";

let total=0;

cart.forEach(item=>{

const div=document.createElement("div");

div.className="cart-item";

div.innerHTML=`

<h4>${item.name}</h4>

<p>€${item.price}</p>

`;

container.appendChild(div);

total+=parseFloat(item.price);

});

document.getElementById("totalPrice").innerText=

"€"+total.toFixed(2);

localStorage.setItem(

"caressCart",

JSON.stringify(cart)

);

}

/* ============================= */

function showToast(){

toast.classList.add("show");

setTimeout(()=>{

toast.classList.remove("show");

},2200);

}

/* ============================= */

const saved=localStorage.getItem("caressCart");

if(saved){

cart=JSON.parse(saved);

updateCart();

}

/* ============================= */
/* PRELOADER */
/* ============================= */

window.addEventListener("load",()=>{

const preloader=document.getElementById("preloader");

preloader.style.opacity="0";

setTimeout(()=>{

preloader.remove();

},900);

});
